<?xml version="1.0" encoding="utf-8"?>
<!-- Native cold-start splash shown by SplashActivity for a fixed minimum
     duration, see SplashActivity.java for why this is a real layout
     instead of the AndroidX SplashScreen API. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ImageView
        android:id="@+id/splashGlow"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="center"
        android:src="@drawable/splash_glow"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/splashIcon"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_gravity="center"
        android:src="@mipmap/ic_launcher_foreground"
        android:contentDescription="@null" />

</FrameLayout>
