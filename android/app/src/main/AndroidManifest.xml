<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".SplashActivity"
            android:theme="@style/SplashTheme"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBar"
            android:launchMode="singleTask"
            android:exported="true">

            <!-- Google Drive OAuth hands back into the app through this
                 custom-scheme redirect (see oauth-redirect.html and
                 MainActivity's onNewIntent). singleTask above is what makes
                 onNewIntent fire on the already-running instance instead of
                 spawning a second one. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" />
            </intent-filter>

            <!-- Registers sQUIZit as a candidate ("Open with") handler for
                 .html files, so a quiz shared from shareQuizAsHtml() in
                 app.js can open straight into the real app on a receiving
                 phone that has it installed, instead of just a plain
                 browser. Scoped to the "text/html" mime type, not a
                 filename pattern, because content:// Uris handed over by
                 another app's share sheet (Messenger, Bluetooth, Gmail...)
                 don't expose a real filename/path Android can match
                 against, so mime type is the only thing reliably
                 available. That does mean sQUIZit becomes a candidate
                 opener for ANY .html file on the phone, not only its own
                 exports; MainActivity only special-cases files that
                 actually contain a sQUIZit quiz payload (looks for the
                 squizit-quiz-data script block) and quietly ignores
                 anything else, so this is safe even for unrelated html. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/html" android:scheme="content" />
                <data android:mimeType="text/html" android:scheme="file" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Was missing entirely: the in-app Camera Capture feature uses
         getUserMedia() in the WebView, which Android will refuse before the
         app even gets a chance to prompt the user, if this isn't declared. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Same reasoning as CAMERA above: Class Sessions' live video calls
         (Jitsi, embedded via getUserMedia() in the WebView) need this
         declared before Capacitor's BridgeWebChromeClient.onPermissionRequest()
         is even allowed to prompt for microphone access. Only takes effect
         on a rebuilt, reinstalled APK; existing installs keep working for
         everything except class-session audio until reinstalled. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Lets MainActivity's downloadAndInstallApk trigger Android's package
         installer directly on a downloaded update APK, instead of handing
         off to the browser's own download flow (found stuck indefinitely
         on-device, since Play Protect silently scans a debug-signed,
         unrecognized-publisher APK before allowing an install action).
         Declaring this permission does NOT grant it; the user still gets
         a one-time system "allow installs from this app" prompt, same as
         any app outside the Play Store, this just makes the app eligible
         to ask. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
